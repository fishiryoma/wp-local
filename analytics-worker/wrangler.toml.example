name = "your-site-name-analytics"
main = "worker.js"
compatibility_date = "2025-01-01"
account_id = "your-cloudflare-account-id"

# Cron Trigger：依你的時區調整（範例是 UTC 18:00 = 台灣時間凌晨 2 點）
[triggers]
crons = ["0 18 * * *"]

# KV Namespace：執行 wrangler kv namespace create ANALYTICS 後填入 id
[[kv_namespaces]]
binding = "ANALYTICS_KV"
id = "your-kv-namespace-id"
