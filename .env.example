# Cloudflare Analytics 同步設定
# 警告：此檔案含機敏資訊，已列入 .gitignore，請勿推上 Git
# 使用方式：複製這份檔案為 .env，再填入下方各項真實值

# Cloudflare Analytics Token（需有 Zone Analytics:Read 權限）
# 注意：故意不用 CF_API_TOKEN 命名，避免 wrangler 自動抓取誤用
ANALYTICS_TOKEN=

# Cloudflare Zone ID
CF_ZONE_ID=

# Cloudflare Account ID（用於存取 KV）
CLOUDFLARE_ACCOUNT_ID=

# Cloudflare KV Namespace ID（執行 wrangler kv namespace create ANALYTICS 後填入）
KV_NAMESPACE_ID=

# Local WP MySQL 連線設定
# DB_PORT 請在 Local WP 中確認：開啟 Local WP → 點選你的網站 → Database 分頁 → MySQL Port
DB_HOST=localhost
DB_PORT=
DB_NAME=local
DB_USER=root
DB_PASSWORD=
DB_TABLE_PREFIX=wp_

# DB 備份 R2 Bucket
R2_BACKUP_BUCKET=
# R2 存取金鑰（若已 aws configure 設定好可留空；或在 Cloudflare Dashboard -> R2 -> Manage API tokens 取得）
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# 日文校對工具 (style-editor) 用
# 到 https://aistudio.google.com/apikey 建立免費的 Gemini API Key 後貼在這裡
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
