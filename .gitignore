# ── Local WP ────────────────────────────────────────────────────
# Exclude entire app/ except get-all-urls.php
app/*
!app/public/
app/public/*
!app/public/get-all-urls.php

# Environment variables
**/.envrc
.env
.env.*
.dev.vars
!.env.example
!analytics-worker/.dev.vars.example

# Database (contains all WordPress data and hashed passwords)
*.sql

# Server config
conf/
logs/

# ── Generated output ─────────────────────────────────────────────
deploy/

# ── Wrangler (contains Account ID and email) ────────────────────
**/.wrangler/

# ── Python ───────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo

# ── Script cache ─────────────────────────────────────────────────
.compress-cache.json
.analytics-sync.json
.backup-state.json

# build-static.py 抓頁面失敗時的清單（刻意放在 deploy/ 外，避免被部署成公開檔案）
_failed_urls.txt

# ── style-editor (日文校對工具) ────────────────────────────────────
style-editor/sessions/
style-editor/backups/
style-editor/factcheck_exports/

# ── OS ───────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
