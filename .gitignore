# ── Local WP ────────────────────────────────────────────────────
# Exclude entire app/ except get-all-urls.php
app/*
!app/public/
app/public/*
!app/public/get-all-urls.php

# Environment variables
**/.envrc
.env
.env.*
.dev.vars

# Database (contains all WordPress data and hashed passwords)
*.sql

# Server config
conf/
logs/

# ── Generated output ─────────────────────────────────────────────
deploy/

# ── Wrangler (contains Account ID and email) ────────────────────
**/.wrangler/

# ── Python ───────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo

# ── Script cache ─────────────────────────────────────────────────
.compress-cache.json
.analytics-sync.json

# ── style-editor (日文校對工具) ────────────────────────────────────
style-editor/sessions/
style-editor/backups/

# ── OS ───────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
