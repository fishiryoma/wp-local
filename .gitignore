# ── Local WP ────────────────────────────────────────────────────
# Exclude entire app/ except get-all-urls.php
app/*
!app/public/
app/public/*
!app/public/get-all-urls.php

# Environment variables
**/.envrc
.env
.env.*
.dev.vars
!.env.example
!analytics-worker/.dev.vars.example

# Database (contains all WordPress data and hashed passwords)
*.sql

# Server config
conf/
logs/

# ── Generated output ─────────────────────────────────────────────
deploy/

# ── Wrangler (contains Account ID, KV Namespace ID, bucket/project names) ──
**/.wrangler/
**/wrangler.toml
!**/wrangler.toml.example

# ── Python ───────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo

# ── Script cache ─────────────────────────────────────────────────
.compress-cache.json
.analytics-sync.json
.backup-state.json

# build-static.py 抓頁面失敗時的清單（刻意放在 deploy/ 外，避免被部署成公開檔案）
_failed_urls.txt

# ── style-editor (日文校對工具，已拆成獨立 repo：fishiryoma/style-editor) ──
style-editor/

# ── OS ───────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
